	public:
	void showgrandparent(){
		cout << "this is grandparent class" << endl;
	}
};
 
 class parent: public grandparent {
 	public:
 	void showparent(){
 		cout << "this is parent class" << endl;
 	}
 };
 
 class child: public parent{
 	public:
 	void showchild(){
 		cout << "this is child class" << endl;
 	}
 };
 
 int main(){
 	grandparent g;
